DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRE_MINUTES=1440
ADMIN_EMAIL=you@example.com
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-5.6-luna
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-latest
ALLOWED_ORIGINS=https://rotryai-frontend.onrender.com,https://rotryai.vercel.app

# Forgot-password emails (SMTP - works with Gmail App Passwords, Resend,
# SendGrid, Mailgun, etc.) and the link's frontend base URL.
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASSWORD=your_smtp_api_key_or_app_password
SMTP_FROM=Rotryai <noreply@yourdomain.com>
FRONTEND_URL=https://rotryai.vercel.app

# Google sign-in ("Continue with Google"). Create an OAuth Client ID
# (type: Web application) at https://console.cloud.google.com/apis/credentials
# and add your frontend URL(s) to "Authorized JavaScript origins".
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
